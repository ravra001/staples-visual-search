# Python
__pycache__/
*.pyc
*.egg-info/

# Virtual environments
.venv/
venv/

# Packaged bundles
*.zip

# Bundled CLIP model weights (~577 MB) — exceeds GitHub's 100 MB file limit.
# Not stored in git. It auto-downloads on the first CLIP run, or copy the
# backend/models/ folder in manually for a fully-offline install.
backend/models/

# Multi-angle / text-fusion experiments (regenerable)
backend/static/images/multiview/
backend/data/catalog_multiview*.json
backend/data/index_multiview*.npz
backend/data/index_compare.npz

# Local secrets — never commit real credentials (e.g. DATABASE_URL for a live
# Cloud SQL instance). Set these locally; they're read at test/run time only.
backend/.env.local
backend/.env.local.txt
*.env.local
*.env.local.txt
.env*

# Locally-generated cert bundle for GRPC TLS interception workaround (machine-specific)
backend/windows_roots.pem
backend/combined_roots.pem
